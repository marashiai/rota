# Optional. Copy to secrets/common.env (all agents) or secrets/<agent>.env (one agent), inside the team folder. KEY=VALUE, one per line.
# GitHub needs nothing here: each agent's gh_user names a gh login on the executing machine and the
# organizer takes GH_TOKEN from it at shift time. Set GH_TOKEN here only to override that.
# Claude needs nothing here when claude is logged in on the machine; otherwise: claude setup-token.
#CLAUDE_CODE_OAUTH_TOKEN=
#GH_TOKEN=
